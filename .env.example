# Neon Postgres connection string (Prisma + Neon serverless adapter).
# Get it from https://console.neon.tech → your project → Connection Details.
# Use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js v5 — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# API-Football (API-Sports) free-tier key — https://dashboard.api-football.com
API_FOOTBALL_KEY=""

# Current UCL season (API-Football season year, e.g. 2024 = 2024/25)
UCL_SEASON="2024"

# Secret for Vercel Cron auth — sent as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=""
